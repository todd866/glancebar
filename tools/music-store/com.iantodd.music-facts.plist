<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The facts builder (tools/music-store/facts.py), the only writer of music/facts.json: daily at
     22:30Z on the hub, after the 19:40Z catalogue. Network only (MusicBrainz, LRCLIB, Wikipedia;
     one request a second, 1,500 a run); resumes from its cache. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.iantodd.music-facts</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/iantodd/.local/bin/utc-daily</string>
    <string>--label</string><string>com.iantodd.music-facts</string>
    <string>--at</string><string>22:30</string>
    <string>--</string>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/iantodd/Projects/glancebar/tools/music-store/facts.py</string>
    <string>build</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartInterval</key><integer>300</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/iantodd/.local/state/music-store/facts.out.log</string>
  <key>StandardErrorPath</key><string>/Users/iantodd/.local/state/music-store/facts.err.log</string>
</dict>
</plist>
