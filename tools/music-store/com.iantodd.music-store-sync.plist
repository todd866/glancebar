<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The hub's half of the shared music store (docs/music-unify.md): every 10 min, copy this Mac's
     taste-log shards to the bucket (the TV's likes), derive the 6IAN radio's own events into the log,
     and pull ids.json / facts.json for the TV. Not a daily job, so no utc-daily. No drive access. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.iantodd.music-store-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/iantodd/Projects/glancebar/tools/music-store/musicstore.py</string>
    <string>sync</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartInterval</key><integer>600</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/iantodd/.local/state/music-store/sync.out.log</string>
  <key>StandardErrorPath</key><string>/Users/iantodd/.local/state/music-store/sync.err.log</string>
</dict>
</plist>
