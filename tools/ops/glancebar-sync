#!/bin/bash
# glancebar-sync — keep the installed Glancebar on origin/main, from the signing Mac.
#
# Owner, 14 Nov 2026: "Keep glancebar sync'd". Agents pushed 61 commits to main between 6 and
# 14 Nov and nobody ran glancebar-deploy, so the M5 ran week-old code and the workers' updater
# logged "matching signed release unavailable" every 15 minutes: they install only a signed
# release, and only this Mac can sign one.
#
# Run by the LaunchAgent com.iantodd.glancebar-sync every 30 minutes on the M5. Each run:
#   1. fast-forwards the checkout to origin/main (skips a checkout off main or with tracked edits)
#   2. stops if the installed commit is already HEAD
#   3. runs the test suite on a worker (remote-run -- ./tests.sh); a red suite is not deployed
#   4. runs glancebar-deploy: signed release, install here, relaunch. The workers' own
#      glancebar-update then fetches that release within 15 minutes.
# A commit that fails its tests or its deploy is tried once, then left until main moves again;
# the failure is mailed to the project once.
#
#   glancebar-sync            do it
#   glancebar-sync --status   say where things stand; change nothing
# State and log: ~/.local/state/glancebar-sync/. Exit 0 when in sync or deliberately skipped.
set -uo pipefail
export PATH="${GLANCEBAR_PATH_PREFIX:+$GLANCEBAR_PATH_PREFIX:}/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:${HOME}/.local/bin"

repo=${GLANCEBAR_REPO:-$HOME/Projects/glancebar}
state=${GLANCEBAR_SYNC_STATE:-$HOME/.local/state/glancebar-sync}
installed_file=${GLANCEBAR_STATE_DIR:-$HOME/.local/state/glancebar-update}/installed
deploy=${GLANCEBAR_DEPLOY_BIN:-$repo/tools/ops/glancebar-deploy}
tests=${GLANCEBAR_TESTS_CMD:-remote-run -- ./tests.sh}
mail=${GLANCEBAR_MAIL_BIN:-$HOME/.local/bin/agent-mail}
mkdir -p "$state"
log=$state/log
say() { printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%MZ')" "$*" | tee -a "$log"; }

chip=${GLANCEBAR_SYNC_CHIP:-$(sysctl -n machdep.cpu.brand_string 2>/dev/null || true)}
if [ "$chip" != "Apple M5" ]; then
  echo "glancebar-sync: only the signing Mac (M5) runs this; workers use glancebar-update"
  exit 0
fi

installed=$(head -n 1 "$installed_file" 2>/dev/null || true)
head_sha=$(git -C "$repo" rev-parse HEAD 2>/dev/null || true)

if [ "${1:-}" = "--status" ]; then
  origin=$(git -C "$repo" rev-parse origin/main 2>/dev/null || true)
  echo "installed ${installed:-none}"
  echo "checkout  ${head_sha:-none}"
  echo "origin    ${origin:-unknown} (as last fetched)"
  [ -f "$state/failed" ] && echo "failed    $(cat "$state/failed")"
  [ -n "$installed" ] && [ "$installed" = "$origin" ] && echo "in sync" || echo "behind"
  exit 0
fi

# One run at a time: a build takes longer than the interval.
if ! mkdir "$state/lock" 2>/dev/null; then
  holder=$(cat "$state/lock/pid" 2>/dev/null || true)
  if [ -n "$holder" ] && kill -0 "$holder" 2>/dev/null; then
    exit 0
  fi
  rmdir "$state/lock" 2>/dev/null || { rm -f "$state/lock/pid"; rmdir "$state/lock" 2>/dev/null; }
  mkdir "$state/lock" 2>/dev/null || exit 0
fi
echo $$ > "$state/lock/pid"
trap 'rm -f "$state/lock/pid"; rmdir "$state/lock" 2>/dev/null' EXIT

branch=$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
if [ "$branch" != main ]; then
  say "skip: checkout is on ${branch:-nothing}, not main"
  exit 0
fi
if [ -n "$(git -C "$repo" status --porcelain --untracked-files=no)" ]; then
  say "skip: tracked files are modified (someone is working in the checkout)"
  exit 0
fi
if ! git -C "$repo" fetch -q origin main 2>/dev/null; then
  exit 0          # offline: nothing to do, and not worth a log line every half hour
fi
if ! git -C "$repo" merge -q --ff-only origin/main 2>/dev/null; then
  say "skip: main has local commits that are not on origin (glancebar-deploy pushes them)"
  exit 0
fi
head_sha=$(git -C "$repo" rev-parse HEAD)
[ "$installed" = "$head_sha" ] && exit 0

if [ "$(cat "$state/failed" 2>/dev/null | cut -d' ' -f1)" = "$head_sha" ]; then
  exit 0          # already tried and reported; wait for main to move
fi

fail() {
  say "$1"
  printf '%s %s\n' "$head_sha" "$1" > "$state/failed"
  [ -x "$mail" ] && "$mail" send "m5:glancebar" "glancebar-sync: ${head_sha:0:7} was not deployed: $1. Log: $log. It will be tried again when main moves." >/dev/null 2>&1
  exit 1
}

say "main is at ${head_sha:0:7}, installed is ${installed:0:7}: testing"
if ! (cd "$repo" && $tests) > "$state/tests.log" 2>&1; then
  fail "tests failed (see $state/tests.log)"
fi
say "tests passed: deploying"
if ! "$deploy" "$repo" > "$state/deploy.log" 2>&1; then
  fail "deploy failed: $(tail -n 1 "$state/deploy.log")"
fi
rm -f "$state/failed"
say "deployed ${head_sha:0:7}"
